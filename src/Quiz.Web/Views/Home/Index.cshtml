@{
    ViewData["Title"] = "Quiz";
}
@model Quiz.Web.Models.QuestionViewModel

<section class="question-card" aria-labelledby="question-title">
    <p id="question-label" class="eyebrow">Übungsfrage</p>
    <h1 id="question-title">@Model.Text</h1>

    <form id="answer-form" asp-controller="Home" asp-action="SubmitAnswer" method="post">
        @Html.AntiForgeryToken()
        <input id="question-index" type="hidden" name="questionIndex" value="@Model.Index" />
        <fieldset id="answer-options" class="answer-options">
            <legend class="visually-hidden">Wähle eine Antwort</legend>
            @for (var optionIndex = 0; optionIndex < Model.Options.Count; optionIndex++)
            {
                var option = Model.Options[optionIndex];
                var inputId = $"answer-{Model.Index}-{optionIndex}";
                <label class="answer-option" for="@inputId">
                    <input id="@inputId" type="radio" name="answer" value="@option" />
                    <span>@option</span>
                </label>
            }
        </fieldset>

        <button id="submit-answer" class="btn btn-primary answer-button" type="submit" disabled>
            Antworten
        </button>
        <p id="answer-feedback" class="answer-feedback" role="status" aria-live="polite"></p>
    </form>
    <p id="quiz-result" class="quiz-result" role="status" aria-live="polite" hidden></p>
</section>
